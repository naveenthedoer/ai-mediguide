# ── MediGuide-specific exclusions ────────────────────────────────────────────

# Terraform state — contains GCP resource IDs and internal metadata
# NEVER commit these — recreate with: agents-cli infra datastore
deployment/terraform/**/*.tfstate
deployment/terraform/**/*.tfstate.backup
deployment/terraform/**/.terraform/

# Deployment metadata — contains Agent Runtime ID and project number
# Document these values in README instead
deployment_metadata.json

# Eval artifacts — auto-generated, large, not needed in repo
artifacts/

# SA key files — should never be committed under any name
*-key.json
*-sa-key.json
*.serviceaccount.json
service-account*.json

# Auto-generated by agents-cli deploy — rebuilt every deploy
app/app_utils/.requirements.txt

# Local env overrides (in addition to .env already ignored above)
*.env.local
.env.*
!.env.example

# Python cache in nested dirs (supplement to existing rules)
app/**/__pycache__/
deployment/**/__pycache__/

# macOS extended attributes
._*
.Spotlight-V100
.Trashes

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# uv cache
.uv/
